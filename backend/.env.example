# Application Environment
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","https://app.latrobeirrigation.com.au"]

# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# QuickBooks Online OAuth2 & API
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/v1/quickbooks/callback
QUICKBOOKS_REALM_ID=your_quickbooks_realm_id
QUICKBOOKS_ACCESS_TOKEN=your_initial_access_token
QUICKBOOKS_REFRESH_TOKEN=your_initial_refresh_token
QUICKBOOKS_ENVIRONMENT=sandbox

# Telegram Bot Alerts & Webhook
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=your_super_secret_telegram_webhook_token
TELEGRAM_WEBHOOK_BASE_URL=https://api.latrobeirrigation.com.au

# LLM Natural Language Routing (Gemini / OpenAI compatible)
GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-2.5-flash
